[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/settings_menu.gd" id="1_settings"]
[ext_resource type="Shader" path="res://shaders/ui_frost.gdshader" id="2_frost"]

[sub_resource type="StyleBoxEmpty" id="StyleBox_settings_panel"]

[sub_resource type="ShaderMaterial" id="FrostMaterial"]
shader = ExtResource("2_frost")
shader_parameter/blur_lod = 3.2
shader_parameter/tint = Color(0.027, 0.102, 0.173, 0.5)
shader_parameter/vignette = 0.35
shader_parameter/amount = 1.0

[node name="SettingsMenu" type="PanelContainer"]
process_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBox_settings_panel")
script = ExtResource("1_settings")

[node name="Frost" type="ColorRect" parent="."]
