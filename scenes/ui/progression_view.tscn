[ext_resource type="Texture2D" path="res://art/synty/ui/icons_3d/SPR_ModernMenus_Icon_Currency_Coin_01_Ortho.png" id="4_coin"]

[sub_resource type="ShaderMaterial" id="FrostMaterial"]
shader = ExtResource("2_frost")
shader_parameter/blur_lod = 3.2
shader_parameter/tint = Color(0.027, 0.102, 0.173, 0.5)
shader_parameter/vignette = 0.35
shader_parameter/amount = 1.0

[node name="ProgressionView" type="Control"]
visible = false
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
