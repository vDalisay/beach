# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Local platform exports
/android/
/builds/

# Supplied vendor project stays local; only its import boundary is tracked.
Assets/Synty/*
!Assets/Synty/.gdignore

# Regenerated from the licensed local source by tools/stage_assets.gd.
/art/synty/

# Marketing-only: Steam store art and the in-engine plate render that feeds it.
/marketing/
/tools/capsule_render.gd
/tools/capsule_render.gd.uid

